# Base URL only (no trailing /api — it's added by the app). Examples:
# Production: VITE_APP_API_URL=https://9jasettlement.com
# Dev (auth service Spring): VITE_APP_API_URL=https://apis-dev.9jasettlement.com
# Verify: GET https://apis-dev.9jasettlement.com/api/as/actuator/health
# If you use .../api, the app will strip it to avoid double /api/api/ in paths.
VITE_APP_API_URL=https://9jasettlement.com

# Dev proxy only: path prefix when forwarding to backend (default /api). Set to empty if backend has no prefix:
# VITE_DEV_PROXY_PATH_PREFIX=
# VITE_DEV_PROXY_PATH_PREFIX=/api
